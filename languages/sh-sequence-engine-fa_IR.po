msgstr "%s — کپی"

msgid "You do not have permission to duplicate sequences."
msgstr "اجازه کپی کردن سکانس‌ها را ندارید."

msgid "The duplicate request could not be verified."
msgstr "درخواست کپی قابل تأیید نبود."

