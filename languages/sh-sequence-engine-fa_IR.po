msgstr "نام و قالب"

msgid "Upload Frames"
msgstr "آپلود فریم‌ها"

msgid "Content Steps"
msgstr "مراحل محتوا"

msgid "Golden Master"
msgstr "تصویر پایانی"

msgid "Preview & Publish"
msgstr "پیش‌نمایش و انتشار"

msgid "Step %d saved."
msgstr "مرحله %d ذخیره شد."

msgid "Sequence name"
msgstr "نام سکانس"

msgid "e.g. Homepage Hero"
msgstr "مثلاً: قهرمان صفحه اصلی"

msgid "Internal name — not shown to visitors."
msgstr "نام داخلی — برای بازدیدکنندگان نمایش داده نمی‌شود."

msgid "Start from a template (optional)"
msgstr "شروع از یک قالب (اختیاری)"

msgid "Choose a production-ready structure, or leave blank to start fresh."
msgstr "یک ساختار آماده انتخاب کنید یا خالی بگذارید و از صفر شروع کنید."

msgid "Blank"
msgstr "خالی"

msgid "Start with no template."
msgstr "شروع بدون قالب."

msgid "frames"
msgstr "فریم"

msgid "scenes"
msgstr "صحنه"

msgid "Save & Continue →"
msgstr "ذخیره و ادامه ←"

msgid "← Back"
msgstr "→ بازگشت"

msgid "AI Frame Generation (Pro)"
msgstr "تولید فریم هوش مصنوعی (حرفه‌ای)"

msgid "Describe the opening scene. The AI will generate the Start Frame (DALL·E 3) and interpolate all frames (Replicate FILM). Your Golden Master becomes the End Frame."
msgstr "صحنه ابتدایی را توصیف کنید. هوش مصنوعی فریم شروع را می‌سازد (DALL·E 3) و تمام فریم‌ها را درون‌یابی می‌کند (Replicate FILM). تصویر پایانی شما فریم پایان می‌شود."

msgid "Camera far away, product tiny in centre, clean white studio, soft shadows…"
msgstr "دوربین از دور، محصول کوچک در مرکز، استودیوی سفید تمیز، سایه‌های ملایم…"

msgid "AI generation runs in the background after saving — come back in a few minutes."
msgstr "تولید هوش مصنوعی پس از ذخیره در پس‌زمینه اجرا می‌شود — چند دقیقه دیگر برگردید."

msgid "— or upload frames manually —"
msgstr "— یا فریم‌ها را دستی آپلود کنید —"

msgid "Frames (%1$d / %2$d) — WebP recommended"
msgstr "فریم‌ها (%1$d از %2$d) — WebP توصیه می‌شود"

msgid "+ Add Frames from Media Library"
msgstr "+ افزودن فریم از کتابخانه رسانه"

msgid "Upload %d WebP images (1280×720 recommended) numbered in order. They play frame-by-frame as the visitor scrolls."
msgstr "%d تصویر WebP (1280×720 توصیه‌شده) به ترتیب آپلود کنید. با اسکرول بازدیدکننده فریم به فریم پخش می‌شوند."

msgid "Select Frames"
msgstr "انتخاب فریم‌ها"

msgid "Add frames"
msgstr "افزودن فریم‌ها"

msgid "Remove"
msgstr "حذف"

msgid "Content overlays — up to %1$d (%2$s plan). Each step fades in at the scroll %% position you set."
msgstr "رویه‌های محتوایی — تا %1$d عدد (طرح %2$s). هر مرحله در موقعیت اسکرول %% که تعیین کنید محو می‌شود."

msgid "Step %s"
msgstr "مرحله %s"

msgid "Step"
msgstr "مرحله"

msgid "Scroll %%"
msgstr "اسکرول %%"

msgid "Heading"
msgstr "عنوان"

msgid "Main headline…"
msgstr "عنوان اصلی…"

msgid "Paragraph"
msgstr "پاراگراف"

msgid "Subtext…"
msgstr "متن فرعی…"

msgid "CTA Text"
msgstr "متن دکمه"

msgid "Get started"
msgstr "شروع کنید"

msgid "CTA URL"
msgstr "لینک دکمه"

msgid "Badge / Price"
msgstr "نشان / قیمت"

msgid "e.g. &#x1F525; 20% off"
msgstr "مثلاً: 🔥 ۲۰٪ تخفیف"

msgid "+ Add overlay step"
msgstr "+ افزودن مرحله رویه"

msgid "Golden Master — End Frame (the final frame of your animation)"
msgstr "تصویر پایانی — آخرین فریم انیمیشن شما"

msgid "Upload the single confirmed \"last frame\" image for each device size. Desktop must be confirmed first. Tablet and Mobile fall back to Desktop if not set."
msgstr "تصویر «آخرین فریم» تأییدشده را برای هر سایز دستگاه آپلود کنید. دسکتاپ باید اول تأیید شود. تبلت و موبایل در صورت عدم تنظیم به دسکتاپ بازمی‌گردند."

msgid "Desktop (confirm first)"
msgstr "دسکتاپ (اول تأیید کنید)"

msgid "Tablet"
msgstr "تبلت"

msgid "Mobile"
msgstr "موبایل"

msgid "Confirmed"
msgstr "تأییدشده"

msgid "(Confirm desktop first)"
msgstr "(اول دسکتاپ را تأیید کنید)"

msgid "No image selected"
msgstr "تصویری انتخاب نشده"

msgid "Select image"
msgstr "انتخاب تصویر"

msgid "Select Golden Master"
msgstr "انتخاب تصویر پایانی"

msgid "Use this image"
msgstr "استفاده از این تصویر"

msgid "This Golden Master is final and confirmed"
msgstr "این تصویر پایانی نهایی و تأییدشده است"

msgid "Ready to publish?"
msgstr "آماده انتشار هستید؟"

msgid "%d frame uploaded"
msgstr "%d فریم آپلود شد"

msgid "%d frames uploaded"
msgstr "%d فریم آپلود شد"

msgid "Desktop Golden Master confirmed"
msgstr "تصویر پایانی دسکتاپ تأیید شد"

msgid "Sequence is published"
msgstr "سکانس منتشر شده است"

msgid "👁 Open Preview in new tab"
msgstr "👁 باز کردن پیش‌نمایش در تب جدید"

msgid "The preview runs at full fidelity — same frames and overlays as the live version, protected by a short-lived token."
msgstr "پیش‌نمایش با کیفیت کامل اجرا می‌شود — همان فریم‌ها و رویه‌های نسخه زنده، محافظت‌شده با توکن کوتاه‌مدت."

msgid "Embed shortcode"
msgstr "شورت‌کد جاسازی"

msgid "Paste this into any page or post where you want the hero animation."
msgstr "این را در هر صفحه یا نوشته‌ای که می‌خواهید انیمیشن قهرمان نمایش داده شود جایگذاری کنید."

msgid "Publish Sequence"
msgstr "انتشار سکانس"

msgid "Upload at least one frame and confirm the Desktop Golden Master before publishing."
msgstr "حداقل یک فریم آپلود کنید و تصویر پایانی دسکتاپ را قبل از انتشار تأیید کنید."

msgid "✓ Sequence is live!"
msgstr "✓ سکانس منتشر شد!"

msgid "All Sequences →"
msgstr "→ همه سکانس‌ها"

msgid "Permission denied."
msgstr "دسترسی رد شد."

msgid "Invalid sequence."
msgstr "سکانس نامعتبر."

# ── Templates page ────────────────────────────────────────────────────────

msgid "Pick a template to pre-fill the wizard with a production structure — scenes, beats, overlay slots and frame contract. You upload the frames."
msgstr "یک قالب انتخاب کنید تا جادوگر با ساختار تولیدی پر شود — صحنه‌ها، ریتم‌ها، شیارهای رویه و قرارداد فریم. فریم‌ها را خودتان آپلود می‌کنید."

msgid "+ Blank sequence"
msgstr "+ سکانس خالی"

msgid "No templates found."
msgstr "قالبی یافت نشد."

msgid "Template applied! Continue in the wizard below."
msgstr "قالب اعمال شد! در جادوگر زیر ادامه دهید."

msgid "Use this template"
msgstr "استفاده از این قالب"

msgid "beats"
msgstr "ریتم"

msgid "Overlay slots:"
msgstr "شیارهای رویه:"

msgid "Master frame %d"
msgstr "فریم اصلی %d"

# ── Settings page ─────────────────────────────────────────────────────────

msgid "StoryBoard Live Settings"
msgstr "تنظیمات استوری‌بورد زنده"

msgid "AI Generation (Pro) — API Keys"
msgstr "تولید هوش مصنوعی (حرفه‌ای) — کلیدهای API"

msgid "Privacy notice:"
msgstr "اطلاعیه حریم خصوصی:"

msgid "When you generate frames, your uploaded images and text prompt are sent to the configured AI provider (OpenAI and/or Replicate). Each provider's privacy policy applies. Do not generate frames containing personal or sensitive information."
msgstr "هنگام تولید فریم، تصاویر آپلودشده و متن دستور شما به ارائه‌دهنده هوش مصنوعی پیکربندی‌شده (OpenAI و/یا Replicate) ارسال می‌شود. سیاست حریم خصوصی هر ارائه‌دهنده اعمال می‌شود. فریم‌هایی حاوی اطلاعات شخصی یا حساس تولید نکنید."

msgid "OpenAI API Key"
msgstr "کلید API اوپن‌ای‌آی"

msgid "sk-…"
msgstr "sk-…"

msgid "Create a key at %s. Used to generate the Start Frame from your prompt (DALL·E 3)."
msgstr "یک کلید در %s بسازید. برای تولید فریم شروع از دستور شما (DALL·E 3) استفاده می‌شود."

msgid "Replicate API Token"
msgstr "توکن API رپلیکیت"

msgid "r8_…"
msgstr "r8_…"

msgid "Create a token at %s. Used to interpolate 24–36 frames from Start → End (FILM model)."
msgstr "یک توکن در %s بسازید. برای درون‌یابی ۲۴ تا ۳۶ فریم از شروع تا پایان (مدل FILM) استفاده می‌شود."

msgid "Pro Plan"
msgstr "طرح حرفه‌ای"

msgid "Enable Pro features (AI generation, 15 heroes, 36 frames, 10 content steps)"
msgstr "فعال‌سازی ویژگی‌های حرفه‌ای (تولید هوش مصنوعی، ۱۵ قهرمان، ۳۶ فریم، ۱۰ مرحله محتوا)"

msgid "Sprint 3 placeholder — will be replaced by verified license-key check in a future release."
msgstr "جایگاه نگهدار اسپرینت ۳ — در نسخه آینده با بررسی کلید مجوز تأییدشده جایگزین می‌شود."

msgid "Mobile animation"
msgstr "انیمیشن موبایل"

msgid "Disable scroll animation on mobile devices (show static last frame instead)"
msgstr "غیرفعال کردن انیمیشن اسکرول در دستگاه‌های موبایل (به جای آن آخرین فریم ثابت نمایش داده می‌شود)"

msgid "Remove data on uninstall"
msgstr "حذف داده‌ها هنگام حذف نصب"

msgid "Delete all plugin data (sequences, frames, settings) when the plugin is uninstalled"
msgstr "حذف تمام داده‌های افزونه (سکانس‌ها، فریم‌ها، تنظیمات) هنگام حذف نصب افزونه"

msgid "StoryBoard Live version %s"
msgstr "نسخه استوری‌بورد زنده %s"

msgid "Test OpenAI"
msgstr "تست اوپن‌ای‌آی"

msgid "Test Replicate"
msgstr "تست رپلیکیت"

msgid "Connected successfully."
msgstr "با موفقیت متصل شد."

msgid "Connected as @%s."
msgstr "به عنوان @%s متصل شد."

msgid "Enter a key first."
msgstr "ابتدا یک کلید وارد کنید."

msgid "Testing…"
msgstr "در حال آزمایش…"

msgid "Request failed."
msgstr "درخواست ناموفق بود."

msgid "No API key provided."
msgstr "کلید API ارائه نشده."

msgid "Nonce verification failed."
msgstr "تأیید نانس ناموفق بود."

# ── Meta boxes ────────────────────────────────────────────────────────────

msgid "Golden Master image"
msgstr "تصویر پایانی"

msgid "Upload one confirmed Golden Master (the final frame). The plugin applies the Production Sheet motion, overlays, header reveal and golden handoff to this single image."
msgstr "یک تصویر پایانی تأییدشده (آخرین فریم) آپلود کنید. افزونه حرکت Production Sheet، رویه‌ها، نمایش هدر و انتقال طلایی را روی این تصویر اعمال می‌کند."

msgid "Desktop Golden Master (confirm first)"
msgstr "تصویر پایانی دسکتاپ (اول تأیید کنید)"

msgid "Tablet Golden Master"
msgstr "تصویر پایانی تبلت"

msgid "Mobile Golden Master"
msgstr "تصویر پایانی موبایل"

msgid "Confirm the desktop Golden Master first. The same structure is then applied here."
msgstr "ابتدا تصویر پایانی دسکتاپ را تأیید کنید. سپس همان ساختار اینجا اعمال می‌شود."

msgid "Story Structure"
msgstr "ساختار داستان"

msgid "This sequence does not have a template structure yet. Create one from Ready Templates to start from a complete production sheet."
msgstr "این سکانس هنوز ساختار قالبی ندارد. از قالب‌های آماده یکی بسازید تا از یک Production Sheet کامل شروع کنید."

msgid "Define up to %1$d content overlays (%2$s plan). Each step appears at the scroll %% position you choose."
msgstr "تا %1$d رویه محتوایی تعریف کنید (طرح %2$s). هر مرحله در موقعیت اسکرول %% که انتخاب می‌کنید نمایش داده می‌شود."

msgid "Maximum %d steps reached."
msgstr "حداکثر %d مرحله رسیده شد."

msgid "Upgrade to Pro for 10 steps."
msgstr "ارتقا به حرفه‌ای برای ۱۰ مرحله."

msgid "Select up to %d images from the Media Library to form the scroll sequence. Free plan — no AI generation."
msgstr "تا %d تصویر از کتابخانه رسانه انتخاب کنید تا سکانس اسکرول تشکیل شود. طرح رایگان — بدون تولید هوش مصنوعی."

msgid "Upload your End Frame, enter a prompt, and click Generate to let AI build the frame sequence. Or upload frames manually below."
msgstr "فریم پایانی را آپلود کنید، یک دستور وارد کنید و روی تولید کلیک کنید تا هوش مصنوعی سکانس فریم بسازد. یا فریم‌ها را به صورت دستی آپلود کنید."

msgid "AI Generation (Pro)"
msgstr "تولید هوش مصنوعی (حرفه‌ای)"

msgid "Prompt (describe the starting frame)"
msgstr "دستور (فریم شروع را توصیف کنید)"

msgid "e.g. Camera far away, product tiny in the centre of a clean white studio, soft shadows..."
msgstr "مثلاً: دوربین از دور، محصول کوچک در مرکز استودیوی سفید تمیز، سایه‌های ملایم..."

msgid "AI generation will be available in the next sprint. Your prompt is saved for when the feature launches."
msgstr "تولید هوش مصنوعی در اسپرینت بعدی در دسترس خواهد بود. دستور شما برای زمان راه‌اندازی ویژگی ذخیره می‌شود."

msgid "Frame sequence (%1$d / %2$d)"
msgstr "سکانس فریم (%1$d از %2$d)"

msgid "+ Add Frames"
msgstr "+ افزودن فریم‌ها"

msgid "Remove frame"
msgstr "حذف فریم"

msgid "Add Frames from Media Library"
msgstr "افزودن فریم از کتابخانه رسانه"

# ── Shortcode / Frontend ──────────────────────────────────────────────────

msgid "%s — scroll animation"
msgstr "%s — انیمیشن اسکرول"

msgid "StoryBoard Live — demo frames not found"
msgstr "استوری‌بورد زنده — فریم‌های دمو یافت نشد"

msgid "The [storyboard_live_demo] shortcode requires demo frame images that are not included in the plugin package. Use [storyboard_live id=\"YOUR_ID\"] to embed your own published sequence instead."
msgstr "شورت‌کد [storyboard_live_demo] به تصاویر فریم دمو نیاز دارد که در بسته افزونه گنجانده نشده. به جای آن از [storyboard_live id=\"YOUR_ID\"] برای جاسازی سکانس منتشرشده خود استفاده کنید."

msgid "Interactive visual storytelling for the web"
msgstr "داستان‌سرایی بصری تعاملی برای وب"

msgid "Bring your story to life with every scroll"
msgstr "داستان خود را با هر اسکرول زنده کنید"

msgid "Embed your own sequence with [storyboard_live id=\"YOUR_ID\"]."
msgstr "سکانس خود را با [storyboard_live id=\"YOUR_ID\"] جاسازی کنید."

msgid "StoryBoard Live demo"
msgstr "دمو استوری‌بورد زنده"

