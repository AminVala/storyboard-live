msgid "Preview — %s"
msgstr "پیش‌نمایش — %s"

msgid "Preview link has expired. Go back and generate a fresh preview."
msgstr "لینک پیش‌نمایش منقضی شده. برگردید و پیش‌نمایش جدید بگیرید."

msgid "Preview not available."
msgstr "پیش‌نمایش در دسترس نیست."

msgid "Edit: %s"
msgstr "ویرایش: %s"

msgid "Preview in new tab"
msgstr "پیش‌نمایش در تب جدید"

msgid "(Untitled)"
msgstr "(بی‌عنوان)"

